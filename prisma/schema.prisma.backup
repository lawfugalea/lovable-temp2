generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PageState {
  id          String   @id @default(cuid())
  householdId String
  page        String
  data        Json
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@unique([householdId, page])
}

model User {
  id                      String             @id @default(cuid())
  name                    String?
  email                   String             @unique
  password                String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  activeHouseholdId       String?
  ownedHouseholds         Household[]        @relation("OwnerHouseholds")
  memberships             Membership[]
  notesCreated            Note[]             @relation("NoteCreatedBy")
  ownedNotes              Note[]             @relation("NoteOwner")
  noteCollaborationsAdded NoteCollaborator[] @relation("NoteCollaboratorAddedBy")
  noteCollaborations      NoteCollaborator[] @relation("NoteCollaborator")
  pushSubscriptions       PushSubscription[]
  sharedNotes             Share[]            @relation("NoteShare")
  shoppingItemsCreated    ShoppingItem[]     @relation("ShoppingItemCreatedBy")
  shoppingItemsCompleted  ShoppingItem[]     @relation("ShoppingItemDoneBy")
  activeHousehold         Household?         @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id])
}

model Household {
  id                String             @id @default(cuid())
  name              String
  ownerId           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  children          Child[]
  owner             User?              @relation("OwnerHouseholds", fields: [ownerId], references: [id])
  invites           Invite[]
  members           Membership[]
  notes             Note[]
  pushSubscriptions PushSubscription[]
  shoppingLists     ShoppingList[]
  activeForUsers    User[]             @relation("ActiveHousehold")
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  householdId String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())
  household   Household  @relation(fields: [householdId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@unique([userId, householdId], name: "userId_householdId")
  @@index([householdId])
}

model Invite {
  id           String       @id @default(cuid())
  householdId  String
  email        String?
  role         MemberRole   @default(MEMBER)
  token        String       @unique
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  household    Household    @relation(fields: [householdId], references: [id])
}

model ShoppingList {
  id          String         @id @default(cuid())
  householdId String
  name        String
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       ShoppingItem[]
  household   Household      @relation(fields: [householdId], references: [id])

  @@unique([householdId, name], name: "householdId_name_unique")
  @@index([householdId])
}

model ShoppingItem {
  id          String             @id @default(cuid())
  listId      String
  title       String
  qty         String?
  notes       String?
  category    String?
  store       String?
  status      ShoppingItemStatus @default(ACTIVE)
  createdById String
  doneById    String?
  doneAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   User               @relation("ShoppingItemCreatedBy", fields: [createdById], references: [id])
  doneBy      User?              @relation("ShoppingItemDoneBy", fields: [doneById], references: [id])
  list        ShoppingList       @relation(fields: [listId], references: [id])

  @@index([listId])
  @@index([status])
  @@index([updatedAt])
}

model Store {
  id        String         @id @default(cuid())
  name      String
  domain    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  offers    PriceOffer[]
  products  PriceProduct[]
}

model PriceProduct {
  id             String       @id @default(cuid())
  storeId        String
  name           String
  brand          String?
  sku            String?
  sourceUrl      String       @unique
  imageUrl       String?
  nameNormalized String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  offers         PriceOffer[] @relation("ProductOffers")
  store          Store        @relation(fields: [storeId], references: [id])

  @@index([storeId, nameNormalized])
}

model PriceOffer {
  id         String       @id @default(cuid())
  productId  String
  priceCents Int
  currency   String       @default("EUR")
  unit       String?
  scrapedAt  DateTime     @default(now())
  storeId    String?
  category   String?
  product    PriceProduct @relation("ProductOffers", fields: [productId], references: [id])
  Store      Store?       @relation(fields: [storeId], references: [id])

  @@index([productId, scrapedAt])
}

model ShoppingTemplate {
  id          String                 @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime               @default(now())
  items       ShoppingTemplateItem[]

  @@index([householdId])
}

model ShoppingTemplateItem {
  id         String           @id @default(cuid())
  templateId String
  productId  String?
  name       String
  quantity   Decimal          @default(1)
  unitId     String?
  categoryId String?
  note       String?
  template   ShoppingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([unitId])
  @@index([categoryId])
}

model Child {
  id            String             @id @default(cuid())
  householdId   String
  name          String
  dateOfBirth   DateTime
  notes         String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  household     Household          @relation(fields: [householdId], references: [id])
  feverReadings FeverReading[]
  medicines     Medicine[]
  doses         MedicineDose[]
  reactions     MedicineReaction[]
  reminders     MedicineReminder[]

  @@index([householdId])
}

model Medicine {
  id                 String             @id @default(cuid())
  childId            String?
  name               String
  description        String?
  dosage             String
  frequency          String
  startDate          DateTime
  endDate            DateTime?
  isActive           Boolean            @default(true)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  nextDoseOverride   DateTime?
  overrideReason     String?
  isTemplate         Boolean            @default(false)
  currentQuantity    Int?
  doctorName         String?
  expiryDate         DateTime?
  lowStockThreshold  Int?
  medicineType       String?
  pharmacyName       String?
  prescriptionDate   DateTime?
  prescriptionNumber String?
  totalQuantity      Int?
  unit               String?
  child              Child?             @relation(fields: [childId], references: [id])
  doses              MedicineDose[]
  reactions          MedicineReaction[]
  reminders          MedicineReminder[]

  @@index([childId])
  @@index([isActive])
  @@index([isTemplate])
}

model MedicineDose {
  id         String   @id @default(cuid())
  childId    String
  medicineId String
  takenAt    DateTime
  dosage     String
  notes      String?
  takenBy    String?
  createdAt  DateTime @default(now())
  child      Child    @relation(fields: [childId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([childId, takenAt])
  @@index([medicineId])
  @@index([takenAt])
}

model MedicineReminder {
  id           String       @id @default(cuid())
  childId      String
  medicineId   String
  scheduledAt  DateTime
  reminderType ReminderType
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  child        Child        @relation(fields: [childId], references: [id])
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@index([childId, scheduledAt])
  @@index([medicineId])
  @@index([scheduledAt, isActive])
}

model MedicineReaction {
  id           String   @id @default(cuid())
  childId      String
  medicineId   String
  reactionType String
  severity     String
  description  String
  symptoms     String?
  occurredAt   DateTime
  duration     String?
  actionTaken  String?
  notes        String?
  createdAt    DateTime @default(now())
  child        Child    @relation(fields: [childId], references: [id])
  medicine     Medicine @relation(fields: [medicineId], references: [id])

  @@index([childId, occurredAt])
  @@index([medicineId])
  @@index([reactionType])
}

model PushSubscription {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  endpoint    String
  p256dhKey   String
  authKey     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
}

model FeverReading {
  id          String   @id @default(cuid())
  childId     String
  temperature Float
  unit        String   @default("C")
  method      String   @default("oral")
  takenAt     DateTime @default(now())
  notes       String?
  takenBy     String?
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, takenAt])
  @@index([takenAt])
}

model Note {
  id            String             @id @default(cuid())
  title         String
  content       String?
  isShared      Boolean?           @default(false)
  color         String             @default("yellow")
  isPinned      Boolean?           @default(false)
  isArchived    Boolean?           @default(false)
  createdById   String?
  householdId   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  contentJson   Json?
  contentText   String?
  archived      Boolean            @default(false)
  body          String?
  checklist     Json?
  ocrText       String?
  ownerId       String?
  pinned        Boolean            @default(false)
  type          NoteType           @default(TEXT)
  attachments   Attachment[]
  createdBy     User?              @relation("NoteCreatedBy", fields: [createdById], references: [id])
  household     Household?         @relation(fields: [householdId], references: [id])
  owner         User?              @relation("NoteOwner", fields: [ownerId], references: [id])
  collaborators NoteCollaborator[]
  labels        NoteLabel[]
  reminders     Reminder[]
  shares        Share[]

  @@index([ownerId])
  @@index([createdById])
  @@index([householdId])
  @@index([pinned])
  @@index([isPinned])
  @@index([archived])
  @@index([isArchived])
  @@index([isShared])
  @@index([updatedAt])
  @@index([type])
}

model Label {
  id        String      @id @default(cuid())
  name      String
  color     String      @default("blue")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  notes     NoteLabel[]

  @@index([name])
}

model NoteLabel {
  noteId  String
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  note    Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, labelId])
  @@index([noteId])
  @@index([labelId])
}

model Attachment {
  id           String         @id @default(cuid())
  noteId       String
  kind         AttachmentKind @default(IMAGE)
  urlOrBlobRef String
  filename     String?
  mimeType     String?
  size         Int?
  createdAt    DateTime       @default(now())
  note         Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([kind])
}

model Share {
  noteId    String
  userId    String
  role      ShareRole @default(VIEWER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User      @relation("NoteShare", fields: [userId], references: [id])

  @@id([noteId, userId])
  @@index([noteId])
  @@index([userId])
}

model Reminder {
  id         String   @id @default(cuid())
  noteId     String
  dueAt      DateTime
  repeatRule String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([dueAt])
  @@index([isActive])
}

model NoteCollaborator {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  role      NoteRole @default(VIEWER)
  addedAt   DateTime @default(now())
  addedById String
  addedBy   User     @relation("NoteCollaboratorAddedBy", fields: [addedById], references: [id])
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation("NoteCollaborator", fields: [userId], references: [id])

  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
}

enum MemberRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ShoppingItemStatus {
  ACTIVE
  DONE
}

enum ReminderType {
  FIFTEEN_MINUTES
  FIVE_MINUTES
  DUE_NOW
}

enum NoteType {
  TEXT
  CHECKLIST
}

enum AttachmentKind {
  IMAGE
  FILE
}

enum ShareRole {
  VIEWER
  EDITOR
}

enum NoteRole {
  VIEWER
  EDITOR
}
