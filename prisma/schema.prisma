generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PageState {
  id          String   @id @default(cuid())
  householdId String
  page        String
  data        Json
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@unique([householdId, page])
}

model User {
  id                     String         @id @default(cuid())
  name                   String?
  email                  String         @unique
  password               String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  activeHouseholdId      String?
  ownedHouseholds        Household[]    @relation("OwnerHouseholds")
  memberships            Membership[]
  shoppingItemsCreated   ShoppingItem[] @relation("ShoppingItemCreatedBy")
  shoppingItemsCompleted ShoppingItem[] @relation("ShoppingItemDoneBy")
  activeHousehold        Household?     @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id])
  notesCreated           Note[]         @relation("NoteCreatedBy")
  noteCollaborations     NoteCollaborator[] @relation("NoteCollaborator")
  noteCollaborationsAdded NoteCollaborator[] @relation("NoteCollaboratorAddedBy")
}

model Household {
  id             String         @id @default(cuid())
  name           String
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          User           @relation("OwnerHouseholds", fields: [ownerId], references: [id])
  invites        Invite[]
  members        Membership[]
  shoppingLists  ShoppingList[]
  activeForUsers User[]         @relation("ActiveHousehold")
  children       Child[]
  notes          Note[]
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  householdId String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())
  household   Household  @relation(fields: [householdId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@unique([userId, householdId], name: "userId_householdId")
  @@index([householdId])
}

model Invite {
  id           String       @id @default(cuid())
  householdId  String
  email        String?
  role         MemberRole   @default(MEMBER)
  token        String       @unique
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  household    Household    @relation(fields: [householdId], references: [id])
}

model ShoppingList {
  id          String         @id @default(cuid())
  householdId String
  name        String
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       ShoppingItem[]
  household   Household      @relation(fields: [householdId], references: [id])

  @@unique([householdId, name], name: "householdId_name_unique")
  @@index([householdId])
}

model ShoppingItem {
  id          String             @id @default(cuid())
  listId      String
  title       String
  qty         String?
  notes       String?
  category    String?
  store       String?
  status      ShoppingItemStatus @default(ACTIVE)
  createdById String
  doneById    String?
  doneAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   User               @relation("ShoppingItemCreatedBy", fields: [createdById], references: [id])
  doneBy      User?              @relation("ShoppingItemDoneBy", fields: [doneById], references: [id])
  list        ShoppingList       @relation(fields: [listId], references: [id])

  @@index([listId])
  @@index([status])
  @@index([updatedAt])
}

model Store {
  id        String         @id @default(cuid())
  name      String
  domain    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  offers    PriceOffer[]
  products  PriceProduct[]
}

model PriceProduct {
  id             String       @id @default(cuid())
  storeId        String
  name           String
  brand          String?
  sku            String?
  sourceUrl      String       @unique
  imageUrl       String?
  nameNormalized String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  offers         PriceOffer[] @relation("ProductOffers")
  store          Store        @relation(fields: [storeId], references: [id])

  @@index([storeId, nameNormalized])
}

model PriceOffer {
  id         String       @id @default(cuid())
  productId  String
  priceCents Int
  currency   String       @default("EUR")
  unit       String?
  scrapedAt  DateTime     @default(now())
  storeId    String?
  category   String?
  product    PriceProduct @relation("ProductOffers", fields: [productId], references: [id])
  Store      Store?       @relation(fields: [storeId], references: [id])

  @@index([productId, scrapedAt])
}

enum MemberRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ShoppingItemStatus {
  ACTIVE
  DONE
}

model ShoppingTemplate {
  id          String                 @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime               @default(now())
  items       ShoppingTemplateItem[] // <-- one-to-many

  @@index([householdId])
}

model ShoppingTemplateItem {
  id String @id @default(cuid())

  // FK column
  templateId String

  // RELATION field (this is what Prisma was missing)
  template ShoppingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // optional link to catalogue product
  productId String?

  name       String
  quantity   Decimal @default(1)
  unitId     String?
  categoryId String?
  note       String?

  @@index([templateId])
  @@index([unitId])
  @@index([categoryId])
}

// Kids Medicine Control Models
model Child {
  id          String   @id @default(cuid())
  householdId String
  name        String
  dateOfBirth DateTime
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  household     Household @relation(fields: [householdId], references: [id])
  medicines     Medicine[]
  doses         MedicineDose[]
  reminders     MedicineReminder[]
  feverReadings FeverReading[]
  
  @@index([householdId])
}

model Medicine {
  id          String   @id @default(cuid())
  childId     String?  // Optional for templates, required for active courses
  name        String
  description String?
  dosage      String   // e.g., "5ml", "1 tablet", "2 drops"
  frequency   String   // e.g., "every 6 hours", "twice daily", "as needed"
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  isTemplate  Boolean  @default(false) // True for reusable templates, false for active courses
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Next dose override fields
  nextDoseOverride DateTime? // When parent manually sets next dose time
  overrideReason   String?   // Reason for override (e.g., "sleep schedule", "meal timing")
  
  child       Child?        @relation(fields: [childId], references: [id])
  doses       MedicineDose[]
  reminders   MedicineReminder[]
  
  @@index([childId])
  @@index([isActive])
  @@index([isTemplate])
}

model MedicineDose {
  id         String   @id @default(cuid())
  childId    String
  medicineId String
  takenAt    DateTime
  dosage     String   // Actual dosage taken (might differ from prescribed)
  notes      String?
  takenBy    String?  // User ID who administered the dose
  createdAt  DateTime @default(now())
  
  child      Child    @relation(fields: [childId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  
  @@index([childId, takenAt])
  @@index([medicineId])
  @@index([takenAt])
}

model MedicineReminder {
  id         String   @id @default(cuid())
  childId    String
  medicineId String
  scheduledAt DateTime
  reminderType ReminderType
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  child      Child    @relation(fields: [childId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  
  @@index([childId, scheduledAt])
  @@index([medicineId])
  @@index([scheduledAt, isActive])
}

enum ReminderType {
  FIFTEEN_MINUTES
  FIVE_MINUTES
  DUE_NOW
}

model FeverReading {
  id          String   @id @default(cuid())
  childId     String
  temperature Float    // Temperature in Celsius
  unit        String   @default("C") // C or F
  method      String   @default("oral") // oral, rectal, axillary, ear, forehead
  takenAt     DateTime @default(now())
  notes       String?
  takenBy     String?  // Who took the reading
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, takenAt])
  @@index([takenAt])
}

// Notes System Models
model Note {
  id          String   @id @default(cuid())
  title       String
  content     String   // Rich text content (HTML or Markdown)
  isShared    Boolean  @default(false) // true = shared with household, false = personal
  color       String   @default("yellow") // Note color theme
  isPinned    Boolean  @default(false) // Pin important notes
  isArchived  Boolean  @default(false) // Archive old notes
  createdById String
  householdId String?  // null for personal notes, set for shared notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  createdBy   User     @relation("NoteCreatedBy", fields: [createdById], references: [id])
  household   Household? @relation(fields: [householdId], references: [id])
  collaborators NoteCollaborator[] // Users who can edit shared notes
  
  @@index([createdById])
  @@index([householdId])
  @@index([isShared])
  @@index([isPinned])
  @@index([isArchived])
  @@index([updatedAt])
}

model NoteCollaborator {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  role      NoteRole @default(VIEWER) // VIEWER, EDITOR
  addedAt   DateTime @default(now())
  addedById String   // Who added this collaborator
  
  // Relations
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation("NoteCollaborator", fields: [userId], references: [id])
  addedBy   User     @relation("NoteCollaboratorAddedBy", fields: [addedById], references: [id])
  
  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
}

enum NoteRole {
  VIEWER
  EDITOR
}