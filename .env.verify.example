# Template for the throwaway verification stack. Copy to .env.verify, which is
# git-ignored:
#
#   cp .env.verify.example .env.verify
#
# Every value here is synthetic and stays synthetic. The point of this file is
# that the verification stack never loads production .env, so a bug in a patched
# build cannot charge a card, send mail, or reach a real bank connection.
#
# Deliberately absent: STRIPE_SECRET_KEY, RESEND_API_KEY,
# ENABLE_BANKING_PRIVATE_KEY_BASE64, DEEPSEEK_API_KEY, META_CONVERSIONS_TOKEN.
# Each integration is null-guarded and degrades to unconfigured, which is
# exactly what a test stack should see.

# Local to the verification database container only.
HOUSEFLOW_POSTGRES_PASSWORD=verify-only-not-a-real-password

# Mirrors production, where the app is served at the domain root rather than
# under a base path. Must be present-but-empty: docker-compose.yml uses
# ${HOUSEFLOW_BASE_PATH-/houseflow}, which falls back only when the variable is
# unset, not when it is empty.
HOUSEFLOW_BASE_PATH=

# The overlay publishes the app on 127.0.0.1:3100, matching the default
# HOUSEFLOW_TEST_BASE_URL in scripts/test-critical-workflows.mjs.
HOUSEFLOW_PUBLIC_URL=http://127.0.0.1:3100

# Signing key for NextAuth JWTs in this stack. Throwaway by construction.
NEXTAUTH_SECRET=verify-only-nextauth-secret-not-used-anywhere-else

# docker-compose.yml requires this (${ADMIN_EMAILS:?...}), and it must be the
# address the integration suite registers as the owner: the suite asserts that
# the owner can list invites through /api/admin/invites, and it uses the admin
# plan override to comp its own household onto Family so the price-comparison
# assertions mean something. Point this anywhere else and those steps fail.
ADMIN_EMAILS=owner.integration@example.test

HOUSEFLOW_TZ=Europe/Malta

# Supermarket price comparison is deny-by-default, and production currently
# consents to no store at all — so /api/shopping/compare answers 503 there. The
# integration suite asserts a working comparison (UNMATCHED items, zero
# coverage) and an outsider being refused with 403, and both assertions are
# vacuous while the feature is switched off.
#
# Enabling every supported store here exercises that code path. It reads the
# local catalogue tables only, which are empty on a freshly migrated database,
# so nothing in this stack contacts a supermarket site.
HOUSEFLOW_CONSENTED_SUPERMARKET_STORES=smart,greens,welbees,pavipama,happyshopper
