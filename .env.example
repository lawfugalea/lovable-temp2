DATABASE_URL=postgresql://houseflow:change-me@127.0.0.1:5434/houseflow?schema=public
DIRECT_URL=postgresql://houseflow:change-me@127.0.0.1:5434/houseflow?schema=public
DIRECT_DATABASE_URL=postgresql://houseflow:change-me@127.0.0.1:5434/houseflow?schema=public
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com
RESEND_API_KEY=
INVITES_BASE_URL=http://localhost:3000
INVITES_FROM=Clankeep <noreply@clankeep.com>
INVITES_FROM_DOMAIN=clankeep.com
INVITES_REPLY_TO=
UPLOAD_DIR=./uploads

# Optional child-health Web Push. Generate a VAPID pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
REMINDER_WORKER_SECRET=replace-with-at-least-32-random-bytes

# Shared secret for the shopping-recurrence worker, which refills lists from
# templates on their scheduled days. Blank disables scheduled refills; templates
# can still be imported by hand.
SHOPPING_RECURRENCE_SECRET=replace-with-at-least-32-random-bytes

# Supermarket catalogues are parked by default. Add retailer slugs here only
# after written consent; the app and sync worker both use this allow-list.
HOUSEFLOW_CONSENTED_SUPERMARKET_STORES=
# Optional diagnostic subset of the consented stores. Blank syncs all consented stores.
HOUSEFLOW_CATALOG_SYNC_STORES=
HOUSEFLOW_CATALOG_REQUEST_DELAY_MS=250
HOUSEFLOW_GREENS_MAX_PAGES=0
HOUSEFLOW_GREENS_IMAGE_USE_CONFIRMED=false
HOUSEFLOW_PAVIPAMA_MAX_PAGES=0
HOUSEFLOW_PAVIPAMA_PERMISSION_CONFIRMED=false
HOUSEFLOW_HAPPYSHOPPER_MAX_PAGES=0
HOUSEFLOW_PRICE_SYNC_INTERVAL_SECONDS=86400

# Personal read-only Bank of Valletta integration via Enable Banking.
# The finance owner can connect/manage accounts; household members only see
# accounts explicitly shared from the Finance page.
# BANKING_ALLOWED_EMAILS gates the whole banking module (navigation and APIs)
# to the listed accounts while the app runs in restricted production; everyone
# else — including other members of the same household — uses the manual money
# planner. Comma-separated. When unset, FINANCE_OWNER_EMAIL acts as a one-entry
# fallback allowlist. See src/lib/banking-allowlist.ts.
# Day-to-day finance management is otherwise governed by the household plan
# (see billing) and the household-owner role.
# These details are published on /privacy and /terms. For a personal deployment,
# DATA_PROTECTION_EMAIL can be the same monitored address as FINANCE_OWNER_EMAIL.
BANKING_ALLOWED_EMAILS=you@example.com,partner@example.com
PRIVACY_CONTROLLER_NAME=Your full name
DATA_PROTECTION_EMAIL=privacy@example.com
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_BASE64=
# Must exactly match a redirect URL registered on the Enable Banking application.
# Defaults to APP_URL + /api/finance/callback; set it only when the registered URL
# uses a different host or base path than APP_URL.
ENABLE_BANKING_REDIRECT_URL=
# Optional sandbox overrides; production defaults to Bank of Valletta / MT.
ENABLE_BANKING_ASPSP_NAME=Bank Of Valetta
ENABLE_BANKING_ASPSP_COUNTRY=MT

# Meta advertising measurement. All optional: with none of these set, no pixel
# loads and no conversion is reported. Nothing is sent unless the visitor accepts
# non-essential cookies, whichever variables are present.
# The pixel id is public by nature; the token is a system-user credential and must
# never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_TOKEN=
# Routes events to Meta's Events Manager test console instead of live reporting.
META_TEST_EVENT_CODE=

# Optional, manual-only finance analysis. This key stays server-side. Clankeep
# previews and sends only redacted aggregates after explicit user consent.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Demo mode (optional): set both to 'true' to enable the public "Try the demo"
# flow. Demo households are seeded per visitor and expire after 24 hours.
DEMO_MODE_ENABLED=false
NEXT_PUBLIC_DEMO_MODE_ENABLED=false
# Bearer secret for POST /api/internal/demo-cleanup (cron purge of expired demos).
DEMO_CLEANUP_SECRET=

# Stripe billing (optional): the Family plan is sold via Stripe Checkout.
# Leave unset to run free-only; billing endpoints respond 503 until configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_ANNUAL=
BILLING_GRACE_DAYS=7

# Kelma AI chat widget (optional): set the agent id from kelma.chat to show
# the chat bubble on the landing and legal pages. Build-time variable.
NEXT_PUBLIC_KELMA_AGENT_ID=

# Public canonical site URL, used for absolute Open Graph / canonical / sitemap
# URLs on the marketing pages. Build-time variable. Defaults to
# https://clankeep.com when unset.
NEXT_PUBLIC_SITE_URL=https://clankeep.com
