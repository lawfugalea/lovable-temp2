DATABASE_URL=postgresql://houseflow:change-me@127.0.0.1:5434/houseflow?schema=public
DIRECT_URL=postgresql://houseflow:change-me@127.0.0.1:5434/houseflow?schema=public
DIRECT_DATABASE_URL=postgresql://houseflow:change-me@127.0.0.1:5434/houseflow?schema=public
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com
RESEND_API_KEY=
INVITES_BASE_URL=http://localhost:3000
INVITES_FROM=Houseflow <no-reply@galeahub.online>
INVITES_REPLY_TO=
UPLOAD_DIR=./uploads

# Optional child-health Web Push. Generate a VAPID pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
REMINDER_WORKER_SECRET=replace-with-at-least-32-random-bytes

# Optional public supermarket catalogue sync settings.
HOUSEFLOW_CATALOG_SYNC_STORES=smart,welbees
HOUSEFLOW_CATALOG_REQUEST_DELAY_MS=250
HOUSEFLOW_PAVIPAMA_MAX_PAGES=0
HOUSEFLOW_PRICE_SYNC_INTERVAL_SECONDS=86400

# Personal read-only Bank of Valletta integration via Enable Banking.
# The finance owner can connect/manage accounts; household members only see
# accounts explicitly shared from the Finance page.
FINANCE_OWNER_EMAIL=admin@example.com
# These details are published on /privacy and /terms. For a personal deployment,
# DATA_PROTECTION_EMAIL can be the same monitored address as FINANCE_OWNER_EMAIL.
PRIVACY_CONTROLLER_NAME=Your full name
DATA_PROTECTION_EMAIL=privacy@example.com
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_BASE64=
# Optional sandbox overrides; production defaults to Bank of Valletta / MT.
ENABLE_BANKING_ASPSP_NAME=Bank Of Valetta
ENABLE_BANKING_ASPSP_COUNTRY=MT

# Optional, manual-only finance analysis. This key stays server-side. HouseFlow
# previews and sends only redacted aggregates after explicit user consent.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
